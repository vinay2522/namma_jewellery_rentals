# Email Configuration for Booking Notifications
# You'll receive an email every time someone submits a booking

# Email service (gmail, outlook, yahoo, etc.)
EMAIL_SERVICE=gmail

# Your email address (the one that will SEND the emails)
# For Gmail: your.email@gmail.com
EMAIL_USER=your.email@gmail.com

# Email password or App Password
# ⚠️ For Gmail, you MUST use an App Password, not your regular password
# How to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an app password for "Mail"
# 5. Copy the 16-character password here (no spaces)
EMAIL_PASSWORD=your-app-password-here

# Email address where you want to receive booking notifications
# This is usually your business email: nammajewlleryrentals@gmail.com
EMAIL_TO=nammajewlleryrentals@gmail.com

# Admin Login Credentials
ADMIN_USERNAME=admin
# Default password is "admin123" 
# To use a custom password, generate hash using:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# Session Secret (MUST change in production!)
SESSION_SECRET=change-this-to-a-random-long-string-in-production

# Server Configuration
PORT=5000
NODE_ENV=development
